# Copy to an access-controlled host file such as /etc/techatlas/production.env.
# Do not commit the copied file or use development credentials.
TECHATLAS_PUBLIC_HOST=techatlas.dpdns.org
CADDY_EMAIL=ops@example.com

POSTGRES_DB=techatlas
POSTGRES_USER=techatlas
POSTGRES_PASSWORD=replace-with-a-long-random-value
MEILI_MASTER_KEY=replace-with-a-long-random-value
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-value

ADMIN_OIDC_ISSUER=https://dev-6cezdkyjkqhpt8ak.us.auth0.com/
ADMIN_OIDC_AUDIENCE=https://api.techatlas
ADMIN_OIDC_JWKS_URL=https://dev-6cezdkyjkqhpt8ak.us.auth0.com/.well-known/jwks.json
VITE_AUTH0_DOMAIN=dev-6cezdkyjkqhpt8ak.us.auth0.com
VITE_AUTH0_CLIENT_ID=0vvQlrj9ZReU7f4Z2KwF1ypihzL96Zh2
VITE_AUTH0_AUDIENCE=https://api.techatlas

WORKER_CONSUMER_NAME=worker-production-1
WORKER_REGION=production
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_MAX_CONCURRENCY=2
WORKER_ARTIFACT_RETENTION_DAYS=30
WORKER_GEOIP_DATABASE_PATH=/opt/techatlas/GeoLite2-Country.mmdb
WORKER_GEOIP_DATABASE_VERSION=YYYY-MM-DD
WORKER_CRAWLER_USER_AGENT=TechAtlasBot/1.0 (+https://techatlas.dpdns.org/about)
WORKER_CRAWLER_ROBOTS_USER_AGENT=TechAtlasBot
WORKER_CRAWLER_CONTACT=ops@example.com

BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=techatlas-backups
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=replace-with-provider-access-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-provider-secret
BACKUP_S3_PREFIX=techatlas
BACKUP_RETENTION_DAYS=14

# Monitoring ports are localhost-only in production; use an SSH tunnel to access them.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
