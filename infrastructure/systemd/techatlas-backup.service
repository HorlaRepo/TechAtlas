[Unit]
Description=TechAtlas S3 backup and raw-artifact retention
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/techatlas
EnvironmentFile=/etc/techatlas/production.env
ExecStart=/usr/bin/docker compose --env-file /etc/techatlas/production.env -f infrastructure/compose/docker-compose.prod.yml --profile maintenance run --rm backup
ExecStart=/usr/bin/docker compose --env-file /etc/techatlas/production.env -f infrastructure/compose/docker-compose.prod.yml --profile maintenance run --rm artifact-pruner
