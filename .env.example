# Local Docker development ports. PostgreSQL and Redis defaults avoid common host-port conflicts.
DASHBOARD_PORT=5173
POSTGRES_PORT=5433
REDIS_PORT=6380
MEILISEARCH_PORT=7700
API_PORT=3000
SCHEDULER_PORT=3001
WORKER_PORT=3002
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
TEMPO_PORT=3200
OTEL_GRPC_PORT=4317

# Local-only service credentials. Replace all values through secret management before deployment.
POSTGRES_DB=techatlas
POSTGRES_USER=techatlas
POSTGRES_PASSWORD=techatlas_dev_password
MEILI_MASTER_KEY=techatlas_dev_master_key_change_before_production
ADMIN_RATE_LIMIT_PER_MINUTE=60
ADMIN_MUTATION_RATE_LIMIT_PER_MINUTE=30
# Auth0 access-token validation for protected admin operations. These values are public identifiers.
ADMIN_OIDC_ISSUER=https://dev-6cezdkyjkqhpt8ak.us.auth0.com/
ADMIN_OIDC_AUDIENCE=https://api.techatlas
ADMIN_OIDC_JWKS_URL=https://dev-6cezdkyjkqhpt8ak.us.auth0.com/.well-known/jwks.json
VITE_AUTH0_DOMAIN=dev-6cezdkyjkqhpt8ak.us.auth0.com
VITE_AUTH0_CLIENT_ID=0vvQlrj9ZReU7f4Z2KwF1ypihzL96Zh2
VITE_AUTH0_AUDIENCE=https://api.techatlas
# Optional admin-only Grafana or observability landing page. Never include credentials in this URL.
VITE_ADMIN_OBSERVABILITY_URL=http://localhost:3003
RUST_LOG=techatlas_api=info,tower_http=info
DEPENDENCY_CHECK_TIMEOUT_MS=2000
PUBLIC_STALE_AFTER_DAYS=30
PUBLIC_REFRESH_COOLDOWN_HOURS=24
CLI_DATABASE_CONNECT_TIMEOUT_MS=5000

# Worker local defaults. Use a distinct consumer name for every worker replica.
WORKER_CONSUMER_NAME=worker-local-1
WORKER_REGION=local
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_MAX_CONCURRENCY=4
WORKER_CRAWLER_CONNECT_TIMEOUT_MS=5000
WORKER_CRAWLER_READ_TIMEOUT_MS=15000
WORKER_CRAWLER_TOTAL_TIMEOUT_MS=30000
WORKER_CRAWLER_DNS_TIMEOUT_MS=5000
WORKER_CRAWLER_DNS_MAX_ADDRESSES=16
WORKER_CRAWLER_TLS_TIMEOUT_MS=5000
WORKER_CRAWLER_TLS_MAX_ADDRESSES=4
WORKER_CRAWLER_MAX_REDIRECTS=10
WORKER_CRAWLER_MAX_RESPONSE_BYTES=10485760
WORKER_CRAWLER_POLITENESS_DELAY_MS=1000
# Raw response artifacts are stored locally as zstd-compressed, content-addressed files.
WORKER_ARTIFACT_ROOT=.techatlas/artifacts
WORKER_ARTIFACT_RETENTION_DAYS=30
# Historical rule replay is database-backed and deliberately bounded by one claimed item per worker loop.
WORKER_REPROCESSING_POLL_INTERVAL_MS=1000
WORKER_REPROCESSING_RETRY_DELAY_MS=5000
WORKER_REPROCESSING_MAX_ATTEMPTS=3
# Optional local MaxMind GeoLite2 Country metadata. Leave both empty for the default stack.
# Do not commit an MMDB; production requires a mounted, versioned database.
WORKER_GEOIP_DATABASE_PATH=
WORKER_GEOIP_DATABASE_VERSION=
